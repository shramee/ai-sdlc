# ai-sdlc project configuration — sourced as bash by the `ai-sdlc` tool.
#
# Its location defines the project root: every path below is relative to the
# directory holding this file, and `ai-sdlc` finds it by walking up from $PWD.
# Everything here is optional; the defaults shown are what you get if you
# delete a line.

# Name used for log/state paths. Default: project dir name.
# PROJECT_NAME="myproject"

# Repos the fleet works across, as paths relative to the project root. Use
# `.` for a plain single-repo project; list submodule paths for a
# monorepo-of-repos. Default: (.)
REPOS=(.)

# Branch prefixes that mark a branch as agent work, space-separated. A bare
# `ship` considers only branches under one of them (`ship <branch>` ships any
# local branch); `status` lists them plus whatever a dispatch worktree holds.
# Default: "agent/"
# AGENT_BRANCH_PREFIX="agent/ fix/ feat/"

# The opencode invocation, as an argv array (before the repo/model flags
# `dispatch` appends). Default: (opencode run --auto --format json)
# OPENCODE_CMD=(opencode run --auto --format json)

# Model override, passed as `opencode run --model <value>`. Leave unset to
# use opencode's own default/configured model.
# OPENCODE_MODEL="anthropic/claude-sonnet-5"

# Wall-clock cap for one dispatch, in seconds; the worker is killed (TERM,
# then KILL 30s later) and dispatch exits 124. Empty = no limit.
# DISPATCH_TIMEOUT=7200

# A re-dispatch on a branch continues that branch's last opencode session
# (`--session <id>`, recorded in the logs dir). 0 = always start fresh.
# Passing -s/--session/-c/--continue/--fork to dispatch overrides it.
# DISPATCH_RESUME_SESSION=1

# Commit identity for dispatched workers. Passed as GIT_AUTHOR_*/GIT_COMMITTER_*
# env vars to the worker process only — never touches the host's git config.
# AGENT_GIT_NAME="myproject-bot"
# AGENT_GIT_EMAIL="bot@users.noreply.github.com"

# Where logs and host-side worktrees live. Default: <project>/.sdlc/{logs,worktrees}
# STATE_DIR=".sdlc"

# Extra instructions appended to every dispatched prompt. Default: this
# repo's own subagent-instructions.md (worker behavior: reuse, commits,
# mutation checks, agent.log).
# SUBAGENT_INSTRUCTIONS="sdlc/subagent-instructions.md"

# Validation gate for `ship` — the command that must pass (alongside the
# quality gate in quality/thresholds.conf) before a branch is pushed and a PR
# opened. Called as test_cmd_for <repo> <abs-dir>; echo the command to run
# inside that repo, or nothing to fall back to autodetection
# (pnpm/npm/cargo/go/forge/pytest).
# test_cmd_for() {
#     case "$1" in
#         api)      echo "cargo test" ;;
#         web)      echo "pnpm install && pnpm run lint && pnpm run build" ;;
#     esac
# }
