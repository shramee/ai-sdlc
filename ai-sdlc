#!/usr/bin/env bash
# ai-sdlc — the MECHANICS layer: git/gh plumbing + the quality gate.
# No judgment — that lives in .claude/skills/*/SKILL.md (process) and
# .claude/agents/reviewer.md (code). See README.md.
#
# Backend: workers run `opencode` directly on the host, inside a per-branch git
# worktree. No container: isolation is the worktree (never the default branch)
# plus guard/ shims that refuse `git push` and `gh` for the worker.
#
# Usage: ai-sdlc <subcommand> [args...]
#
#   dispatch <repo> <branch> "<prompt>" [extra opencode flags...]
#       Host worktree for <branch> + `opencode run --auto` in it, with
#       subagent-instructions.md appended. Tracks a GitHub issue
#       (status:dispatched), best-effort. Worker commits locally; never pushes.
#       One worker per worktree (locked). Resumes continue the branch's last
#       opencode session. Exits non-zero unless the run made commits and left
#       a clean tree; DISPATCH_TIMEOUT caps wall-clock seconds.
#   vibe <repo> <branch>
#       Same worktree, interactive opencode session for a human.
#   review-context <repo> <branch>
#       Read-only bundle (diff, log, tracked issue, open PR) for the reviewer.
#   quality <repo> [branch]
#       quality/grade.sh (lizard + jscpd) grade; thresholds.conf is the gate.
#   ship [--dry-run] [branch]
#       Host-side (needs `gh`): fetch, then per agent branch ahead of default,
#       run the repo's test command AND the quality gate in the branch's
#       worktree; push + open/update PR only if both green. Refuses a branch
#       with uncommitted/untracked files or a live worker. Failing branches
#       are left unpushed for a fix-up dispatch (exit 1); tips whose PR was
#       already closed/merged are skipped. --dry-run prints the plan only.
#   sync [repo ...]
#       Pull merged default branches; in submodule projects, stage+commit the
#       moved pointer in the parent (never pushes it).
#   status
#       Read-only fleet view: branches, ahead/behind counts, running workers, PRs.
#   checkout <repo> [branch] [--stash|--reset|--wip]
#       Work a branch directly on the host; no branch = interactive picker.
#   restore <repo> [--stash|--reset|--wip]
#       Switch back to the default branch. Same dirty-tree handling as checkout.
#   config | init [dir]
#       Print / write sdlc.conf; resolved by walking up from $PWD
#       (or $SDLC_PROJECT; $SDLC_CONFIG overrides).
#
# Example: ai-sdlc dispatch core agent/fix-nullifier "fix double-spend edge case"
set -euo pipefail

export GIT_PAGER=cat PAGER=cat GH_PAGER=cat GIT_EDITOR=true EDITOR=true VISUAL=true

_resolve_self() {
    local src="${BASH_SOURCE[0]}" dir
    while [ -L "$src" ]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
SDLC_HOME="$(_resolve_self)"

usage() {
    awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SDLC_HOME/ai-sdlc"
    exit "${1:-1}"
}

die() { echo "!! $*" >&2; exit 1; }

# ------------------------------------------------------------- config ------
find_config() {
    if [ -n "${SDLC_CONFIG:-}" ]; then
        [ -f "$SDLC_CONFIG" ] || die "SDLC_CONFIG points at a missing file: $SDLC_CONFIG"
        echo "$SDLC_CONFIG"
        return 0
    fi
    local dir="${SDLC_PROJECT:-$PWD}"
    dir="$(cd "$dir" && pwd)"
    while [ "$dir" != "/" ]; do
        [ -f "$dir/sdlc.conf" ] && { echo "$dir/sdlc.conf"; return 0; }
        dir="$(dirname "$dir")"
    done
    return 1
}

load_config() {
    local conf
    conf="$(find_config)" || die "no sdlc.conf found in $PWD or any parent — run 'ai-sdlc init' to create one"
    CONFIG_FILE="$conf"
    PROJECT_ROOT="$(cd "$(dirname "$conf")" && pwd)"

    PROJECT_NAME="$(basename "$PROJECT_ROOT")"
    REPOS=(.)
    AGENT_BRANCH_PREFIX="agent/"
    # opencode invocation, run from inside the worktree. dispatch appends the
    # prompt (plus any extra flags passed on the command line); vibe drops it.
    OPENCODE_CMD=(opencode run --auto --format json)
    OPENCODE_MODEL=""
    # Env wins over the default, the conf file over both.
    DISPATCH_TIMEOUT="${DISPATCH_TIMEOUT:-}"
    DISPATCH_RESUME_SESSION="${DISPATCH_RESUME_SESSION:-1}"
    PRUNE_LOG_DAYS="${PRUNE_LOG_DAYS:-14}"
    AGENT_GIT_NAME=""
    AGENT_GIT_EMAIL=""
    STATE_DIR=""
    LOGS_DIR=""
    WORKTREES_DIR=""
    SUBAGENT_INSTRUCTIONS="$SDLC_HOME/subagent-instructions.md"
    # shellcheck disable=SC2034
    unset -f test_cmd_for 2>/dev/null || true

    # shellcheck disable=SC1090
    source "$conf"

    : "${STATE_DIR:=$PROJECT_ROOT/.sdlc}"
    [[ "$STATE_DIR" = /* ]] || STATE_DIR="$PROJECT_ROOT/$STATE_DIR"
    : "${LOGS_DIR:=$STATE_DIR/logs}"
    : "${WORKTREES_DIR:=$STATE_DIR/worktrees}"
    [[ "$LOGS_DIR" = /* ]] || LOGS_DIR="$PROJECT_ROOT/$LOGS_DIR"
    [[ "$WORKTREES_DIR" = /* ]] || WORKTREES_DIR="$PROJECT_ROOT/$WORKTREES_DIR"
    [[ "$SUBAGENT_INSTRUCTIONS" = /* ]] || SUBAGENT_INSTRUCTIONS="$PROJECT_ROOT/$SUBAGENT_INSTRUCTIONS"

    [ "${#REPOS[@]}" -gt 0 ] || die "$conf defines no REPOS"
}

# --------------------------------------------------------- repo helpers ----
repo_dir_of() {
    if [ "$1" = "." ]; then echo "$PROJECT_ROOT"; else echo "$PROJECT_ROOT/$1"; fi
}

repo_label_of() {
    if [ "$1" = "." ]; then echo "$PROJECT_NAME"; else echo "${1//\//-}"; fi
}

require_repo() {
    local dir; dir="$(repo_dir_of "$1")"
    [ -e "$dir/.git" ] || { echo "no such repo (or not initialized): $1" >&2; return 1; }
    echo "$dir"
}

# Local first: origin/HEAD is set by clone (or `git remote set-head origin
# --auto`). Only when it's unset do we ask the remote — slow, and needs network.
default_branch_of() {
    local dir="$1" ref br
    if ref="$(git -C "$dir" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)"; then
        echo "${ref#refs/remotes/origin/}"
        return 0
    fi
    br="$(git -C "$dir" remote show origin 2>/dev/null | sed -n '/HEAD branch/s/.*: //p')"
    if [ -n "$br" ] && [ "$br" != "(unknown)" ]; then
        echo "$br"
        return 0
    fi
    for br in main master; do
        git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$br" && { echo "$br"; return 0; }
    done
    echo "!! can't determine the default branch of $dir — run: git -C $dir remote set-head origin --auto" >&2
    return 1
}

# "<behind> <ahead>" of <branch> relative to origin/<default>.
behind_ahead_of() {
    local dir="$1" branch="$2" default_branch="$3" counts
    counts="$(git -C "$dir" rev-list --left-right --count "origin/$default_branch...$branch" 2>/dev/null)" \
        || counts="0 0"
    echo "$counts" | awk '{print $1, $2}'
}

repo_slug_of() {
    git -C "$1" remote get-url origin | sed -E 's#.*github.com[:/](.*)(\.git)?$#\1#; s#\.git$##'
}

project_is_superrepo() {
    [ -e "$PROJECT_ROOT/.git" ] && [ -f "$PROJECT_ROOT/.gitmodules" ]
}

default_test_cmd() {
    local dir="$1"
    if [ -f "$dir/pnpm-lock.yaml" ]; then
        echo "pnpm install && pnpm test"
    elif [ -f "$dir/package-lock.json" ] || [ -f "$dir/package.json" ]; then
        echo "npm install && npm test"
    elif [ -f "$dir/Cargo.toml" ]; then
        echo "cargo test"
    elif [ -f "$dir/go.mod" ]; then
        echo "go test ./..."
    elif [ -f "$dir/foundry.toml" ]; then
        echo "forge test"
    elif [ -f "$dir/pyproject.toml" ]; then
        echo "pytest"
    else
        echo ""
    fi
}

validation_cmd_for() {
    local repo="$1" dir="$2" cmd=""
    if declare -F test_cmd_for >/dev/null; then
        cmd="$(test_cmd_for "$repo" "$dir" || true)"
    fi
    [ -n "$cmd" ] || cmd="$(default_test_cmd "$dir")"
    echo "$cmd"
}

# Every branch a `checkout` could land on: local heads plus origin branches
# with no local counterpart yet.
checkoutable_branches() {
    local dir="$1"
    {
        git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads
        git -C "$dir" for-each-ref --format='%(refname)' refs/remotes/origin \
            | sed 's|^refs/remotes/origin/||' | grep -v '^HEAD$' || true
    } | sort -u | grep -v '^$' || true
}

pick_branch() {
    local dir="$1" default_branch="$2" repo="$3"
    local cur; cur="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
    local branches; mapfile -t branches < <(checkoutable_branches "$dir")

    echo "branches in $repo (default $default_branch):" >&2
    local i br marker where ahead
    for i in "${!branches[@]}"; do
        br="${branches[$i]}"
        marker=" "; [ "$br" = "$cur" ] && marker="*"
        if git -C "$dir" show-ref --verify --quiet "refs/heads/$br"; then
            where="local"
            git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$br" && where="local+remote"
        else
            where="remote"
        fi
        ahead="$(git -C "$dir" rev-list --count "origin/$default_branch..$br" 2>/dev/null || echo 0)"
        printf '  %2d) %s %-40s %-12s %s ahead of %s\n' \
            "$((i + 1))" "$marker" "$br" "$where" "$ahead" "$default_branch" >&2
    done

    if [ ! -t 0 ] && [ ! -r /dev/tty ]; then
        echo "" >&2
        echo "Pick one with 'ai-sdlc checkout $repo <branch>', or name a new one to create it off $default_branch." >&2
        return 0
    fi

    echo "" >&2
    local reply
    read -r -p "Number, or a new branch name (blank to cancel): " reply < /dev/tty || return 0
    [ -n "$reply" ] || return 0

    if [[ "$reply" =~ ^[0-9]+$ ]]; then
        [ "$reply" -ge 1 ] && [ "$reply" -le "${#branches[@]}" ] || die "no such option: $reply"
        echo "${branches[$((reply - 1))]}"
    else
        echo "$reply"
    fi
}

checkout_or_create() {
    local dir="$1" branch="$2" default_branch="$3"
    if git -C "$dir" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$dir" checkout "$branch"
    elif git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        git -C "$dir" checkout -b "$branch" "origin/$branch"
    else
        git -C "$dir" checkout -b "$branch" "origin/$default_branch"
    fi
}

dirty_mode_flag() {
    for arg in "$@"; do
        case "$arg" in
            --stash) echo stash; return ;;
            --reset) echo reset; return ;;
            --wip) echo wip; return ;;
        esac
    done
}

ensure_clean_or_stash() {
    local dir="$1" mode="${2:-}"
    [ -n "$(git -C "$dir" status --porcelain)" ] || return 0

    if [ -z "$mode" ]; then
        if [ -t 0 ] || [ -r /dev/tty ]; then
            echo "!! $dir has uncommitted changes." >&2
            git -C "$dir" status --short >&2
            echo "What should we do with them? [s]tash / [r]eset --hard (discard) / [c]ommit as wip / [a]bort" >&2
            local choice
            read -r -p "> " choice < /dev/tty
            case "$choice" in
                s|S|"") mode=stash ;;
                r|R) mode=reset ;;
                c|C) mode=wip ;;
                *) echo "Aborted — resolve manually and retry." >&2; exit 1 ;;
            esac
        else
            echo "!! $dir has uncommitted changes and no TTY is attached to ask interactively." >&2
            git -C "$dir" status --short >&2
            echo "Re-run with --stash, --reset, or --wip to resolve automatically." >&2
            exit 1
        fi
    fi

    case "$mode" in
        stash)
            local msg="ai-sdlc auto-stash $(date +%Y-%m-%dT%H:%M:%S)"
            git -C "$dir" stash push -u -m "$msg" >/dev/null
            echo "Stashed as: $msg (git -C $dir stash pop to recover)" >&2
            ;;
        reset)
            git -C "$dir" reset --hard >/dev/null
            git -C "$dir" clean -fd >/dev/null
            echo "Discarded uncommitted changes in $dir." >&2
            ;;
        wip)
            git -C "$dir" add -A
            git -C "$dir" commit -m "wip" >/dev/null
            echo "Committed pending changes as 'wip'." >&2
            ;;
        *)
            echo "!! unknown mode '$mode' — expected stash/reset/wip" >&2
            exit 1
            ;;
    esac
}

open_terminal() {
    local title="$1" cmd="$2"
    local script; script="$(mktemp -t ai-sdlc-open-terminal).sh"
    { echo "#!/usr/bin/env bash"; echo "$cmd"; } > "$script"
    chmod +x "$script"

    if [ -n "${TMUX:-}" ]; then
        tmux new-window -n "$title" "$script; rm -f $script"
    elif [ "$(uname)" = "Darwin" ]; then
        osascript -e "tell application \"Terminal\" to do script \"$script; rm -f $script\"" >/dev/null
    else
        echo "Run:"; echo ""; echo "  $cmd"; echo ""
        rm -f "$script"
    fi
}

# ------------------------------------------------------------- gh tracking -
ensure_status_labels() {
    local slug="$1" label color out
    for label in status:dispatched:fbca04 status:validating:0e8a16; do
        color="${label##*:}"; label="${label%:*}"
        out="$(gh label create "$label" -R "$slug" --color "$color" --force 2>&1 >/dev/null)" \
            || echo "!! couldn't ensure label $label on $slug: $out" >&2
    done
    return 0
}

# Hidden marker in a tracking issue's body; titles get edited, this doesn't.
issue_marker() { echo "<!-- sdlc-branch: $1 -->"; }

# Tracking issue for <branch>: the one whose body carries its marker, else an
# exact title match (issues from before the marker); open beats closed.
# Prints "<number> <STATE>", or nothing if none. Returns 1 when gh fails, so
# callers can tell "no issue" from "couldn't look" — and don't create a dup.
issue_for_branch() {
    local slug="$1" branch="$2" out
    [ -n "$slug" ] || { echo "!! no GitHub slug for origin — can't look up issues" >&2; return 1; }
    if ! out="$(gh issue list -R "$slug" --state all -L 500 --json number,title,body,state 2>&1)"; then
        echo "!! gh issue list failed for $slug: $out" >&2
        return 1
    fi
    jq -r --arg b "$branch" --arg m "$(issue_marker "$branch")" '
        [.[] | select((.body // "") | contains($m))] + [.[] | select(.title == $b)]
        | map(select(.state == "OPEN")) + map(select(.state != "OPEN"))
        | .[0] // empty | "\(.number) \(.state)"' <<<"$out"
}

issue_number_for_branch() {
    local found; found="$(issue_for_branch "$@")" || return 1
    echo "${found%% *}"
}

ensure_issue_for_run() {
    local slug="$1" branch="$2" prompt="$3" found
    ensure_status_labels "$slug"

    if ! found="$(issue_for_branch "$slug" "$branch")"; then
        echo "!! not creating a tracking issue: can't tell whether $branch already has one" >&2
        return 0
    fi

    local issue_num out
    if [ -n "$found" ]; then
        issue_num="${found%% *}"
        if [ "${found#* }" != OPEN ]; then
            out="$(gh issue reopen "$issue_num" -R "$slug" 2>&1 >/dev/null)" \
                || echo "!! couldn't reopen $slug#$issue_num: $out" >&2
        fi
        out="$(gh issue comment "$issue_num" -R "$slug" --body "Re-dispatched:

$prompt" 2>&1 >/dev/null)" || echo "!! couldn't comment on $slug#$issue_num: $out" >&2
        out="$(gh issue edit "$issue_num" -R "$slug" \
            --remove-label "status:validating" --add-label "status:dispatched" 2>&1 >/dev/null)" \
            || echo "!! couldn't relabel $slug#$issue_num: $out" >&2
    else
        if ! out="$(gh issue create -R "$slug" --title "$branch" --label "status:dispatched" --body "$prompt

$(issue_marker "$branch")" 2>&1)"; then
            echo "!! couldn't create a tracking issue on $slug: $out" >&2
            return 0
        fi
        issue_num="$(echo "$out" | sed -nE 's#.*/issues/([0-9]+)$#\1#p' | tail -n1)"
    fi

    echo "$issue_num"
}

# ------------------------------------------------------------ worker glue ---
require_opencode() {
    command -v "${OPENCODE_CMD[0]}" >/dev/null 2>&1 \
        || die "${OPENCODE_CMD[0]} not found on PATH — install https://opencode.ai"
}

# Runs "$@" as a worker: from inside the worktree, with the agent's commit
# identity (env only — never touches the host's git config) and guard/ first on
# PATH so the worker's `git push` and `gh` are refused. A guard against
# accidents, not an adversary: `/usr/bin/git push` still works.
run_worker() {
    local worktree="$1"; shift
    (
        cd "$worktree"
        if [ -n "$AGENT_GIT_NAME" ]; then
            export GIT_AUTHOR_NAME="$AGENT_GIT_NAME" GIT_COMMITTER_NAME="$AGENT_GIT_NAME"
        fi
        if [ -n "$AGENT_GIT_EMAIL" ]; then
            export GIT_AUTHOR_EMAIL="$AGENT_GIT_EMAIL" GIT_COMMITTER_EMAIL="$AGENT_GIT_EMAIL"
        fi
        export AI_SDLC_GUARD_DIR="$SDLC_HOME/guard"
        export PATH="$AI_SDLC_GUARD_DIR:$PATH"
        "$@"
    )
}

# Project thresholds override the tool's defaults — one or the other, never a
# fallback, or failing the project's gate would just retry on the laxer one.
thresholds_file() {
    if [ -f "$PROJECT_ROOT/quality/thresholds.conf" ]; then
        echo "$PROJECT_ROOT/quality/thresholds.conf"
    else
        echo "$SDLC_HOME/quality/thresholds.conf"
    fi
}

# ---------------------------------------------------------------- locks ----
# One worker per worktree. The lock is a mkdir'd dir (atomic on every POSIX fs,
# no flock on macOS) inside the worktree's own git dir, so it never shows up in
# `git status`. It holds the owner's PID and start time; a lock whose PID is
# dead is stale and gets cleared.
lock_dir_of() {
    local gd; gd="$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null)" || return 1
    echo "$gd/ai-sdlc.lock"
}

# Prints "<pid> <started>" if a live process holds <worktree>'s lock.
lock_holder() {
    local lock pid
    lock="$(lock_dir_of "$1")" || return 0
    [ -d "$lock" ] || return 0
    pid="$(cat "$lock/pid" 2>/dev/null || true)"
    # mkdir and the pid write aren't atomic together: give a fresh lock a beat.
    [ -n "$pid" ] || { sleep 1; pid="$(cat "$lock/pid" 2>/dev/null || true)"; }
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "$pid $(cat "$lock/started" 2>/dev/null || echo '?')"
    fi
}

acquire_lock() {
    local wt="$1" lock holder
    lock="$(lock_dir_of "$wt")" || die "$wt is not a git worktree"
    if ! mkdir "$lock" 2>/dev/null; then
        holder="$(lock_holder "$wt")"
        [ -z "$holder" ] \
            || die "$wt is locked by a running worker (pid ${holder%% *}, since ${holder#* }) — wait for it or kill it"
        echo "-- clearing stale lock $lock (pid $(cat "$lock/pid" 2>/dev/null || echo '?') is gone)" >&2
        rm -rf "$lock"
        mkdir "$lock" 2>/dev/null || die "could not take lock $lock"
    fi
    echo "$$" > "$lock/pid"
    date -u +%Y-%m-%dT%H:%M:%SZ > "$lock/started"
}

release_lock() {
    local lock; lock="$(lock_dir_of "$1")" || return 0
    # Only our own lock: never yank one a later run took over.
    [ "$(cat "$lock/pid" 2>/dev/null || true)" = "$$" ] && rm -rf "$lock"
    return 0
}

# ------------------------------------------------------------- dispatch ----
# Local branches under any of AGENT_BRANCH_PREFIX's space-separated prefixes.
agent_branches() {
    local dir="$1" p prefixes
    read -ra prefixes <<<"$AGENT_BRANCH_PREFIX"
    for p in "${prefixes[@]}"; do
        git -C "$dir" for-each-ref --format='%(refname:short)' "refs/heads/$p"
    done | sort -u
}

# Branches checked out in dispatch worktrees (under WORKTREES_DIR), whatever
# their prefix.
dispatch_worktree_branches() {
    local root; root="$(cd -P "$WORKTREES_DIR" 2>/dev/null && pwd)" || return 0
    git -C "$1" worktree list --porcelain | awk -v root="$root/" '
        /^worktree / { wt = substr($0, 10) }
        /^branch refs\/heads\// { if (index(wt, root) == 1) print substr($0, 19) }'
}

# JSON array of every PR (any state) whose head is <branch>. Fails loudly: a
# gh error must never read as "no PR".
prs_for_branch() {
    local slug="$1" br="$2" out
    if [ -z "$slug" ]; then
        echo "!! no GitHub slug for origin — can't look up PRs for $br" >&2
        return 1
    fi
    if ! out="$(gh pr list -R "$slug" --head "$br" --state all -L 50 \
        --json number,state,headRefOid,url 2>&1)"; then
        echo "!! gh pr list failed for $slug:$br: $out" >&2
        return 1
    fi
    echo "$out"
}

# Create (or resume) the worktree at <worktree> for <branch>, branching off
# origin/<default> when the branch doesn't exist yet.
ensure_worktree() {
    local dir="$1" worktree="$2" branch="$3" default_branch="$4"
    if [ -d "$worktree" ] && git -C "$worktree" rev-parse --git-dir >/dev/null 2>&1; then
        echo "Resuming worktree $worktree"
        return 0
    fi
    [ -d "$worktree" ] && { rm -rf "$worktree"; git -C "$dir" worktree prune; }
    echo "Creating worktree $worktree"
    if git -C "$dir" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$dir" worktree add "$worktree" "$branch"
    else
        git -C "$dir" worktree add -b "$branch" "$worktree" "origin/$default_branch"
    fi
}

# Where <branch> is checked out right now, if anywhere: a dispatch worktree,
# or the repo's own checkout after `ai-sdlc checkout`. The main worktree is
# reported as <dir> itself — for submodules git may list it by its gitdir.
worktree_of_branch() {
    local dir="$1" branch="$2"
    git -C "$dir" worktree list --porcelain | awk -v ref="refs/heads/$branch" -v main="$dir" '
        /^worktree / { n++; wt = substr($0, 10) }
        $0 == "branch " ref { print (n == 1 ? main : wt); exit }'
}

# Where dispatch remembers a branch's last opencode session id.
session_file_for() { echo "$LOGS_DIR/$1-${2//\//-}.session"; }

# Runs "$@", killing it after <secs> (empty/0 = no limit) and returning 124,
# like coreutils timeout — which macOS lacks, so this is a portable watchdog.
# The command gets its own process group (set -m) so the kill reaches
# opencode's children too; ^C is forwarded since it's no longer foreground.
with_timeout() {
    local secs="$1"; shift
    if [ -z "$secs" ] || [ "$secs" = 0 ]; then "$@"; return; fi
    local flag; flag="$(mktemp -t ai-sdlc-timeout.XXXXXX)"; rm -f "$flag"
    set -m
    "$@" &
    local pid=$! wd rc=0
    set +m
    # shellcheck disable=SC2064  # expand now: pid is local
    trap "kill -TERM -- -$pid 2>/dev/null" INT TERM HUP
    ( sleep "$secs"; touch "$flag"; kill -TERM -- -"$pid"; sleep 30; kill -KILL -- -"$pid" ) >/dev/null 2>&1 &
    wd=$!
    while kill -0 "$pid" 2>/dev/null; do wait "$pid" || rc=$?; done
    trap - INT TERM HUP
    pkill -P "$wd" 2>/dev/null || true
    kill "$wd" 2>/dev/null || true
    wait "$wd" 2>/dev/null || true
    if [ -e "$flag" ]; then rm -f "$flag"; return 124; fi
    return "$rc"
}

# Resuming a branch whose PR was squash/rebase-merged at this very tip would
# stack new work on commits main already has under other hashes, and the next
# ship would re-PR them. A gh failure only warns: dispatch is best-effort here.
refuse_if_merged() {
    local dir="$1" br="$2" default_branch="$3" slug="$4" behind ahead prs merged
    read -r behind ahead < <(behind_ahead_of "$dir" "$br" "$default_branch")
    [ "$ahead" -gt 0 ] && [ -n "$slug" ] || return 0
    prs="$(prs_for_branch "$slug" "$br")" || { echo "!! couldn't check $br for a merged PR (continuing)" >&2; return 0; }
    merged="$(jq -r --arg tip "$(git -C "$dir" rev-parse "$br")" \
        '[.[] | select(.state == "MERGED" and .headRefOid == $tip)][0].number // empty' <<<"$prs")"
    [ -z "$merged" ] \
        || die "$br was already merged (PR #$merged) — dispatch onto a new branch, or clear it with 'ai-sdlc sync --delete-merged'"
}

# Host-side worktree, so plain git handles staleness/pruning normally.
# Sets (non-local) WORKTREE, LOG_FILE, DEFAULT_BRANCH, RESUMED.
prepare_worktree() {
    local REPO="$1" BRANCH="$2"
    local dir; dir="$(require_repo "$REPO")" || exit 1
    local label; label="$(repo_label_of "$REPO")"

    mkdir -p "$LOGS_DIR" "$WORKTREES_DIR"
    LOG_FILE="$LOGS_DIR/$label-${BRANCH//\//-}.log"
    WORKTREE="$WORKTREES_DIR/$label/${BRANCH//\//-}"
    echo "Logging to $LOG_FILE"

    echo "Fetching $REPO" | tee -a "$LOG_FILE"
    git -C "$dir" fetch origin 2>&1 | tee -a "$LOG_FILE"
    local default_branch; default_branch="$(default_branch_of "$dir")"
    DEFAULT_BRANCH="$default_branch"
    RESUMED=""
    git -C "$dir" show-ref --verify --quiet "refs/heads/$BRANCH" && RESUMED=1

    ensure_worktree "$dir" "$WORKTREE" "$BRANCH" "$default_branch" 2>&1 | tee -a "$LOG_FILE"

    # A resumed branch is used as-is — never rebased — so say how stale it is.
    if [ -n "$RESUMED" ]; then
        local behind ahead
        read -r behind ahead < <(behind_ahead_of "$dir" "$BRANCH" "$default_branch")
        echo "Resuming $BRANCH as-is: $ahead ahead, $behind behind origin/$default_branch" | tee -a "$LOG_FILE"
        [ "$behind" -eq 0 ] \
            || echo "!! not rebased — if the work depends on newer $default_branch, tell the worker to rebase/merge it" | tee -a "$LOG_FILE"
    fi

    ln -sf "$LOG_FILE" "$WORKTREE/agent.log"
    local gitdir; gitdir="$(git -C "$WORKTREE" rev-parse --git-common-dir)"
    case "$gitdir" in /*) ;; *) gitdir="$WORKTREE/$gitdir" ;; esac
    mkdir -p "$gitdir/info"
    grep -qxF "agent.log" "$gitdir/info/exclude" 2>/dev/null || echo "agent.log" >> "$gitdir/info/exclude"
}

cmd_dispatch() {
    local USAGE_LINE='usage: ai-sdlc dispatch <repo> <branch> "<prompt>" [extra opencode flags...]'
    local REPO="${1:?$USAGE_LINE}"
    local BRANCH="${2:?$USAGE_LINE}"
    local PROMPT="${3:?$USAGE_LINE}"
    shift 3

    local WORKTREE LOG_FILE DEFAULT_BRANCH RESUMED
    prepare_worktree "$REPO" "$BRANCH"
    acquire_lock "$WORKTREE"
    # shellcheck disable=SC2064  # expand now: WORKTREE is local
    trap "release_lock '$WORKTREE'" EXIT

    local slug
    slug="$(repo_slug_of "$(repo_dir_of "$REPO")" 2>/dev/null)" || slug=""
    [ -z "$RESUMED" ] || refuse_if_merged "$(repo_dir_of "$REPO")" "$BRANCH" "$DEFAULT_BRANCH" "$slug"

    {
        echo "===== $(date -u +%Y-%m-%dT%H:%M:%SZ) ====="
        echo "branch: $BRANCH"
        echo "prompt: $PROMPT"
        echo "flags: $*"
        echo "---"
    } >> "$LOG_FILE"

    local issue_num
    if [ -n "$slug" ]; then
        issue_num="$(ensure_issue_for_run "$slug" "$BRANCH" "$PROMPT")"
        if [ -n "$issue_num" ]; then
            echo "Tracking issue: $slug#$issue_num" | tee -a "$LOG_FILE"
        else
            echo "!! could not create/find tracking issue for $BRANCH (continuing anyway)" | tee -a "$LOG_FILE"
        fi
    fi

    local instructions=""
    [ -f "$SUBAGENT_INSTRUCTIONS" ] && instructions="$(cat "$SUBAGENT_INSTRUCTIONS")"
    local FULL_PROMPT="$PROMPT

$instructions"

    require_opencode
    # A per-dispatch -m/--model wins over the configured default.
    local model_flags=() arg
    [ -n "$OPENCODE_MODEL" ] && model_flags=(--model "$OPENCODE_MODEL")
    # Re-dispatch continues the branch's last opencode session (its context
    # survives), unless the caller picked a session or DISPATCH_RESUME_SESSION=0.
    local session_file session_flags=() own_session=""
    session_file="$(session_file_for "$(repo_label_of "$REPO")" "$BRANCH")"
    for arg in "$@"; do
        case "$arg" in
            -m|--model|--model=*) model_flags=() ;;
            -s|--session|--session=*|-c|--continue|--fork) own_session=1 ;;
        esac
    done
    if [ -z "$own_session" ] && [ "${DISPATCH_RESUME_SESSION:-1}" != 0 ] && [ -s "$session_file" ]; then
        session_flags=(--session "$(cat "$session_file")")
        echo "Continuing opencode session ${session_flags[1]} (DISPATCH_RESUME_SESSION=0 starts fresh)" | tee -a "$LOG_FILE"
    fi
    [ -z "${DISPATCH_TIMEOUT:-}" ] || echo "Wall-clock limit: ${DISPATCH_TIMEOUT}s" | tee -a "$LOG_FILE"

    # </dev/null: `opencode run` waits for EOF on an inherited non-TTY stdin.
    local rc=0 log_start start_tip
    log_start="$(wc -l < "$LOG_FILE")"
    start_tip="$(git -C "$WORKTREE" rev-parse HEAD)"
    run_worker "$WORKTREE" with_timeout "${DISPATCH_TIMEOUT:-}" \
        "${OPENCODE_CMD[@]}" ${model_flags+"${model_flags[@]}"} ${session_flags+"${session_flags[@]}"} "$@" \
        -- "$FULL_PROMPT" </dev/null 2>&1 | tee -a "$LOG_FILE" || rc=$?

    echo "" >> "$LOG_FILE"
    local session
    session="$(tail -n +"$((log_start + 1))" "$LOG_FILE" \
        | grep -o '"sessionID":"[^"]*"' | head -n1 | cut -d'"' -f4 || true)"
    if [ -n "$session" ]; then
        echo "$session" > "$session_file"
        echo "opencode session: $session" | tee -a "$LOG_FILE"
    fi
    [ "$rc" -ne 124 ] || echo "!! worker hit DISPATCH_TIMEOUT (${DISPATCH_TIMEOUT}s) and was killed" | tee -a "$LOG_FILE" >&2
    # opencode reports provider/auth failures as JSON events buried in the
    # stream; surface the last one so a dead run isn't mistaken for a quiet one.
    local err
    err="$(tail -n +"$((log_start + 1))" "$LOG_FILE" | grep '"type":"error"' | tail -n1 \
        | sed -n 's/.*"message":"\([^"]*\)".*/\1/p' || true)"
    if [ -n "$err" ] || [ "$rc" -ne 0 ]; then
        echo "!! worker failed (rc=$rc): ${err:-see $LOG_FILE}" >&2
        [ "$rc" -ne 0 ] || rc=1
    fi

    # Exit 0 isn't success: the work has to be committed on the branch.
    local commits dirty head
    commits="$(git -C "$WORKTREE" rev-list --count "$start_tip..$BRANCH")"
    dirty="$(git -C "$WORKTREE" status --porcelain --untracked-files=all)"
    head="$(git -C "$WORKTREE" symbolic-ref --quiet --short HEAD || echo "(detached)")"
    echo "-- run made $commits commit(s) on $BRANCH; tree $([ -n "$dirty" ] && echo dirty || echo clean)" \
        | tee -a "$LOG_FILE"
    if [ "$head" != "$BRANCH" ]; then
        echo "!! the worker left $WORKTREE on $head, not $BRANCH" | tee -a "$LOG_FILE" >&2
        rc=1
    fi
    if [ -n "$dirty" ]; then
        echo "!! uncommitted changes left in $WORKTREE:" | tee -a "$LOG_FILE" >&2
        echo "$dirty" | sed 's/^/     /' | tee -a "$LOG_FILE" >&2
        rc=1
    fi
    if [ "$commits" -eq 0 ]; then
        echo "!! the worker made no commits" | tee -a "$LOG_FILE" >&2
        [ "$rc" -ne 0 ] || rc=1
    fi
    [ "$rc" -eq 0 ] || echo "!! dispatch did not finish cleanly — worktree kept for a resume dispatch: $WORKTREE" >&2
    return "$rc"
}

cmd_vibe() {
    local USAGE_LINE="usage: ai-sdlc vibe <repo> <branch>"
    local REPO="${1:?$USAGE_LINE}"
    local BRANCH="${2:?$USAGE_LINE}"

    local WORKTREE LOG_FILE
    prepare_worktree "$REPO" "$BRANCH"
    require_opencode
    local holder; holder="$(lock_holder "$WORKTREE")"
    [ -z "$holder" ] || die "a worker (pid ${holder%% *}) is running in $WORKTREE — wait for it first"

    local model_flags=()
    [ -n "$OPENCODE_MODEL" ] && model_flags=(--model "$OPENCODE_MODEL")

    local cmd="cd \"$WORKTREE\" && opencode ${model_flags[*]:-}"
    echo "Opening interactive opencode session for $REPO:$BRANCH..."
    open_terminal "vibe:$REPO/$BRANCH" "$cmd"
}

# --------------------------------------------------------- review-context --
cmd_review_context() {
    local USAGE_LINE="usage: ai-sdlc review-context <repo> <branch>"
    local REPO="${1:?$USAGE_LINE}"
    local BRANCH="${2:?$USAGE_LINE}"
    local dir; dir="$(require_repo "$REPO")" || exit 1
    local default_branch; default_branch="$(default_branch_of "$dir")"
    local slug; slug="$(repo_slug_of "$dir")"

    echo "## repo: $REPO ($slug)"
    echo "## branch: $BRANCH  (base: $default_branch)"
    echo
    echo "### commit log"
    git -C "$dir" log --format='- %h %s' "origin/$default_branch..$BRANCH" 2>/dev/null || echo "(no commits found — is the branch fetched?)"
    echo
    echo "### full diff"
    echo '```diff'
    git -C "$dir" diff "origin/$default_branch...$BRANCH" 2>/dev/null || echo "(diff unavailable)"
    echo '```'
    echo
    local issue_num; issue_num="$(issue_number_for_branch "$slug" "$BRANCH" || true)"
    if [ -n "$issue_num" ]; then
        echo "### tracking issue #$issue_num"
        gh issue view "$issue_num" -R "$slug" --json title,body,comments \
            --jq '"title: " + .title + "\n\n" + .body + "\n\n---comments---\n" + (.comments | map(.body) | join("\n---\n"))' 2>/dev/null || true
    fi
    echo
    local pr_num
    pr_num="$(gh pr list -R "$slug" --head "$BRANCH" --json number --jq '.[0].number' 2>/dev/null || true)"
    if [ -n "$pr_num" ]; then
        echo "### open PR #$pr_num — implementer's claims"
        gh pr view "$pr_num" -R "$slug" --comments 2>/dev/null || true
    fi
}

# ------------------------------------------------------------- quality ----
cmd_quality() {
    local USAGE_LINE="usage: ai-sdlc quality <repo> [branch]"
    local REPO="${1:?$USAGE_LINE}"
    local BRANCH="${2:-}"
    local dir; dir="$(require_repo "$REPO")" || exit 1
    # Grade the branch's own tree, not whatever the repo has checked out.
    if [ -n "$BRANCH" ]; then
        local wt; wt="$(worktree_of_branch "$dir" "$BRANCH")"
        [ -n "$wt" ] || die "$REPO:$BRANCH isn't checked out anywhere — dispatch or checkout it first"
        dir="$wt"
    fi
    "$SDLC_HOME/quality/grade.sh" "$dir" "$BRANCH" "$(thresholds_file)"
}

# ----------------------------------------------------------------- ship ----
cmd_ship() {
    local USAGE_LINE="usage: ai-sdlc ship [--dry-run] [branch]"
    local DRY_RUN="" FILTER_BRANCH="" arg
    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n) DRY_RUN=1 ;;
            -h|--help) echo "$USAGE_LINE"; return 0 ;;
            -*) die "$USAGE_LINE" ;;
            *) [ -z "$FILTER_BRANCH" ] || die "$USAGE_LINE"; FILTER_BRANCH="$arg" ;;
        esac
    done
    [ -z "$DRY_RUN" ] || echo "(dry run — nothing is created, validated, pushed or opened)"

    # Validates in the worktree that has <br> checked out (creating the
    # dispatch one if none does), so the repo's own checkout is never moved —
    # it can't be anyway: git refuses a branch another worktree holds.
    # Never deletes anything: that worktree may be the user's own checkout.
    ship_one() {
        local dir="$1" br="$2" default_branch="$3" repo="$4" slug="$5" open_pr="$6"
        local wt; wt="$(worktree_of_branch "$dir" "$br")"
        if [ -z "$wt" ]; then
            wt="$WORKTREES_DIR/$(repo_label_of "$repo")/${br//\//-}"
            if [ -n "$DRY_RUN" ]; then
                echo "-- would create worktree $wt"
            else
                mkdir -p "$(dirname "$wt")"
                ensure_worktree "$dir" "$wt" "$br" "$default_branch" || return 1
            fi
        fi
        [ "$wt" != "$dir" ] || echo "-- $br is checked out in $repo's own checkout (checkout mode) — validating there"

        if [ -d "$wt" ]; then
            local holder; holder="$(lock_holder "$wt")"
            if [ -n "$holder" ]; then
                echo "!! a worker (pid ${holder%% *}, since ${holder#* }) is still running in $wt — not shipping a moving branch"
                return 1
            fi
            # Untracked files count: tests would pass on files the push omits.
            local dirty; dirty="$(git -C "$wt" status --porcelain --untracked-files=all)"
            if [ -n "$dirty" ]; then
                echo "!! $wt has uncommitted or untracked files — tests would see them, the push wouldn't."
                echo "   Commit them (dispatch a fix-up), gitignore them, or remove them, then re-ship:"
                echo "$dirty" | sed 's/^/     /'
                return 1
            fi
        fi

        local cmd
        cmd="$(validation_cmd_for "$repo" "$wt")"
        if [ -z "$cmd" ]; then
            echo "!! no validation command for $repo — define test_cmd_for in $CONFIG_FILE"
            return 1
        fi

        local body
        body="$(git -C "$dir" log --format='- %s' "origin/$default_branch..$br")"
        if [ -n "$DRY_RUN" ]; then
            echo "-- would validate in $wt: $cmd"
            echo "-- would run the quality gate: grade.sh $wt $br $(thresholds_file)"
            echo "-- would push $br to origin:"
            echo "$body" | sed 's/^/     /'
            if [ -n "$open_pr" ]; then
                echo "-- would update open PR $open_pr"
            else
                echo "-- would open a PR $br -> $default_branch on $slug"
            fi
            return 0
        fi

        echo "-- validating in $wt: $cmd"
        local vrc=0
        (cd "$wt" && eval "$cmd") || vrc=$?
        if [ "$vrc" -ne 0 ]; then
            echo "!! validation failed for $repo:$br — not pushing"
            return 1
        fi
        # Report, never delete, what validation left behind: it isn't in the
        # push, and the next ship refuses the tree until it's gitignored.
        local leftovers; leftovers="$(git -C "$wt" status --porcelain --untracked-files=all)"
        if [ -n "$leftovers" ]; then
            echo "!! validation left files behind in $wt (not deleted; gitignore or remove them — they block the next ship):"
            echo "$leftovers" | sed 's/^/     /'
        fi

        echo "-- quality gate"
        if ! "$SDLC_HOME/quality/grade.sh" "$wt" "$br" "$(thresholds_file)"; then
            echo "!! quality gate failed for $repo:$br — not pushing (see docs/REVIEW.md)"
            return 1
        fi

        echo "-- validation + quality passed, pushing and opening PR"
        git -C "$dir" push -u origin "$br" || return 1

        local issue_num=""
        if issue_num="$(issue_number_for_branch "$slug" "$br")" && [ -n "$issue_num" ]; then
            body="$body

Closes #$issue_num"
            gh issue edit "$issue_num" -R "$slug" \
                --remove-label "status:dispatched" --add-label "status:validating" >/dev/null \
                || echo "!! could not relabel $slug#$issue_num (continuing)" >&2
        fi

        if [ -n "$open_pr" ]; then
            echo "-- pushed; PR already open: $open_pr"
            return 0
        fi
        local pr_out
        if ! pr_out="$(gh -R "$slug" pr create --head "$br" --base "$default_branch" \
            --title "$br" --body "$body" 2>&1)"; then
            case "$pr_out" in
                *"already exists"*)
                    echo "-- pushed; PR already open:"
                    echo "$pr_out" | grep -o 'https://[^ ]*' | tail -1
                    return 0
                    ;;
                *) echo "$pr_out" >&2; return 1 ;;
            esac
        fi
        echo "$pr_out"
    }

    local failed=() matched=""
    for repo in "${REPOS[@]}"; do
        local dir; dir="$(repo_dir_of "$repo")"
        [ -e "$dir/.git" ] || { echo "skip $repo (not initialized)"; continue; }

        local branches=() outside=()
        if [ -n "$FILTER_BRANCH" ]; then
            git -C "$dir" show-ref --verify --quiet "refs/heads/$FILTER_BRANCH" || continue
            branches=("$FILTER_BRANCH")
        else
            mapfile -t branches < <(agent_branches "$dir")
            mapfile -t outside < <(dispatch_worktree_branches "$dir" | grep -vxF -f <(agent_branches "$dir"; echo) || true)
        fi
        [ "${#outside[@]}" -eq 0 ] \
            || echo "note: $repo has dispatch worktrees outside AGENT_BRANCH_PREFIX ($AGENT_BRANCH_PREFIX), not shipped: ${outside[*]} — name one explicitly to ship it"
        [ "${#branches[@]}" -gt 0 ] || continue
        matched=1

        # Stale origin/<default> skews ahead counts, the PR body and the gate's
        # diff base: fetch once per repo before looking at anything.
        if ! git -C "$dir" fetch -q origin; then
            echo "!! git fetch failed for $repo — skipping it (counts against a stale origin are wrong)"
            failed+=("$repo")
            continue
        fi
        local default_branch slug
        default_branch="$(default_branch_of "$dir")" || { failed+=("$repo"); continue; }
        slug="$(repo_slug_of "$dir" 2>/dev/null || true)"

        local br
        for br in "${branches[@]}"; do
            [ -n "$br" ] || continue
            local behind ahead
            read -r behind ahead < <(behind_ahead_of "$dir" "$br" "$default_branch")
            if [ "$ahead" -eq 0 ]; then
                [ -z "$FILTER_BRANCH" ] || echo "skip $repo:$br — nothing ahead of $default_branch"
                continue
            fi

            # Squash-merged or rejected branches stay "ahead" forever; a PR
            # already closed/merged at this exact tip means it was decided.
            # A gh failure must not read as "no PR": abort this branch.
            local tip prs decided open_pr
            tip="$(git -C "$dir" rev-parse "$br")"
            if ! prs="$(prs_for_branch "$slug" "$br")"; then
                echo "!! can't tell whether $repo:$br already has a PR — not shipping it"
                failed+=("$repo:$br")
                continue
            fi
            decided="$(jq -r --arg tip "$tip" \
                '[.[] | select(.headRefOid == $tip and .state != "OPEN")][0] // empty | "#\(.number) \(.state)"' <<<"$prs")"
            if [ -n "$decided" ]; then
                echo "skip $repo:$br — PR $decided at this tip (delete the branch, or add commits to reship)"
                continue
            fi
            open_pr="$(jq -r '[.[] | select(.state == "OPEN")][0].url // empty' <<<"$prs")"

            echo "== $repo : $br ($ahead ahead, $behind behind $default_branch) =="
            if ! ship_one "$dir" "$br" "$default_branch" "$repo" "$slug" "$open_pr"; then
                echo "!! failed for $repo:$br (validate/quality/push/PR) — not proceeding further on this branch"
                failed+=("$repo:$br")
            fi
        done
    done

    if [ -n "$FILTER_BRANCH" ] && [ -z "$matched" ]; then
        echo "!! no repo in REPOS has a local branch named $FILTER_BRANCH" >&2
        return 1
    fi
    if [ "${#failed[@]}" -gt 0 ]; then
        echo "!! not shipped: ${failed[*]}" >&2
        return 1
    fi
}

# ----------------------------------------------------------------- sync ----
cmd_sync() {
    local repos=("$@")
    [ "${#repos[@]}" -eq 0 ] && repos=("${REPOS[@]}")

    sync_one() {
        local dir="$1" default_branch="$2"
        git -C "$dir" checkout "$default_branch"
        git -C "$dir" pull --ff-only origin "$default_branch"
    }

    local updated=()

    for repo in "${repos[@]}"; do
        local dir; dir="$(repo_dir_of "$repo")"
        [ -e "$dir/.git" ] || { echo "skip $repo (not initialized)"; continue; }

        local default_branch orig_branch before after
        default_branch="$(default_branch_of "$dir")"
        orig_branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
        before="$(git -C "$dir" rev-parse HEAD)"

        if ! sync_one "$dir" "$default_branch"; then
            echo "!! sync failed for $repo — skipping"
            git -C "$dir" checkout "$orig_branch" || echo "!! could not restore $repo to $orig_branch"
            continue
        fi

        after="$(git -C "$dir" rev-parse HEAD)"
        if [ "$before" != "$after" ]; then
            echo "$repo: $before -> $after"
            if project_is_superrepo && [ "$repo" != "." ]; then
                git -C "$PROJECT_ROOT" add "$repo"
                updated+=("$repo")
            fi
        fi
    done

    if [ "${#updated[@]}" -eq 0 ]; then
        echo "No parent-repo pointers to update."
        return 0
    fi

    # Pathspec: commit only the moved pointers, not whatever else is staged.
    git -C "$PROJECT_ROOT" commit -m "chore: sync ${updated[*]} to latest upstream" -- "${updated[@]}"
    echo "Committed parent repo update for: ${updated[*]}"
    echo "Review with 'git show', then push manually when ready."
}

# ------------------------------------------------------------- checkout ----
cmd_checkout() {
    local USAGE_LINE="usage: ai-sdlc checkout <repo> [branch] [--stash|--reset|--wip]"
    local REPO="${1:?$USAGE_LINE}"
    local BRANCH="${2:-}"
    case "$BRANCH" in --*) BRANCH="" ;; esac
    local mode; mode="$(dirty_mode_flag "${@:2}")"
    local dir; dir="$(require_repo "$REPO")" || exit 1

    git -C "$dir" fetch origin
    local default_branch; default_branch="$(default_branch_of "$dir")"

    if [ -z "$BRANCH" ]; then
        BRANCH="$(pick_branch "$dir" "$default_branch" "$REPO")"
        [ -n "$BRANCH" ] || { echo "Nothing selected." >&2; return 0; }
    fi

    ensure_clean_or_stash "$dir" "$mode"
    checkout_or_create "$dir" "$BRANCH" "$default_branch"

    echo ""
    echo "$REPO is now on $BRANCH (created/resumed off $default_branch) for direct work"
    echo "on the host — no worker dispatched."
    echo "Follow $SUBAGENT_INSTRUCTIONS: stage everything (git add .) and"
    echo "commit early and often as steps complete."
    echo "Run 'ai-sdlc restore $REPO' when done; a later 'ai-sdlc dispatch' on this"
    echo "branch picks up whatever was committed here."

    open_terminal "checkout:$REPO/$BRANCH" "cd \"$dir\" && exec \"\${SHELL:-bash}\" -l"
}

cmd_restore() {
    local USAGE_LINE="usage: ai-sdlc restore <repo> [--stash|--reset|--wip]"
    local REPO="${1:?$USAGE_LINE}"
    local mode; mode="$(dirty_mode_flag "${@:2}")"
    local dir; dir="$(require_repo "$REPO")" || exit 1

    ensure_clean_or_stash "$dir" "$mode"

    local default_branch
    default_branch="$(default_branch_of "$dir")"
    git -C "$dir" checkout "$default_branch"
    echo "$REPO restored to $default_branch"
}

# --------------------------------------------------------------- status ----
cmd_status() {
    for repo in "${REPOS[@]}"; do
        local dir; dir="$(repo_dir_of "$repo")"
        [ -e "$dir/.git" ] || { echo "== $repo: not initialized =="; continue; }

        local default_branch cur dirty
        default_branch="$(default_branch_of "$dir")" || { echo "== $repo: unknown default branch =="; continue; }
        cur="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
        dirty="$(git -C "$dir" status --porcelain | wc -l | tr -d ' ')"

        echo "== $repo (on $cur, default $default_branch, $dirty dirty file(s)) =="

        # Agent branches plus anything a dispatch worktree holds, whatever its prefix.
        { agent_branches "$dir"; dispatch_worktree_branches "$dir"; } | sort -u | while read -r br; do
            [ -z "$br" ] && continue
            local behind ahead
            read -r behind ahead < <(behind_ahead_of "$dir" "$br" "$default_branch")
            local wt live="" holder
            wt="$(worktree_of_branch "$dir" "$br")"
            if [ -n "$wt" ]; then
                holder="$(lock_holder "$wt")"
                [ -n "$holder" ] && live=" [worker running, pid ${holder%% *} since ${holder#* }]"
            fi
            echo "  branch $br: $ahead ahead, $behind behind $default_branch$live"
        done

        local slug
        slug="$(repo_slug_of "$dir")"
        # Go templates don't unescape "\n" — the newline must be literal.
        gh -R "$slug" pr list --json number,title,headRefName,state \
            --template '{{range .}}  PR #{{.number}} [{{.state}}] {{.headRefName}}: {{.title}}
{{end}}' 2>/dev/null || echo "  (could not list PRs)"
    done
}

# --------------------------------------------------------------- config ----
cmd_config() {
    cat <<EOF
config file : $CONFIG_FILE
project     : $PROJECT_NAME
project root: $PROJECT_ROOT
repos       : ${REPOS[*]}
branch prefix: $AGENT_BRANCH_PREFIX
opencode cmd: ${OPENCODE_CMD[*]} ${OPENCODE_MODEL:+--model $OPENCODE_MODEL}
logs        : $LOGS_DIR
worktrees   : $WORKTREES_DIR
instructions: $SUBAGENT_INSTRUCTIONS
superrepo   : $(project_is_superrepo && echo yes || echo no)
EOF
    local repo dir
    for repo in "${REPOS[@]}"; do
        dir="$(repo_dir_of "$repo")"
        [ -e "$dir/.git" ] || { echo "  $repo: (not initialized)"; continue; }
        echo "  $repo: $(validation_cmd_for "$repo" "$dir")"
    done
}

# ----------------------------------------------------------------- init ----
cmd_init() {
    local target="${1:-$PWD}"
    target="$(cd "$target" && pwd)"
    local conf="$target/sdlc.conf"
    [ -e "$conf" ] && die "$conf already exists"
    cp "$SDLC_HOME/examples/sdlc.conf.example" "$conf"
    echo "Wrote $conf — edit REPOS / test_cmd_for / OPENCODE_MODEL, then run 'ai-sdlc config'."
}

# ----------------------------------------------------------------- main ----
[ $# -eq 0 ] && usage
SUBCOMMAND="$1"; shift

case "$SUBCOMMAND" in
    -h|--help|help) usage 0 ;;
    init) cmd_init "$@"; exit 0 ;;
esac

load_config

case "$SUBCOMMAND" in
    dispatch)       cmd_dispatch "$@" ;;
    vibe)           cmd_vibe "$@" ;;
    review-context) cmd_review_context "$@" ;;
    quality)        cmd_quality "$@" ;;
    ship)           cmd_ship "$@" ;;
    sync)           cmd_sync "$@" ;;
    status)         cmd_status "$@" ;;
    checkout)       cmd_checkout "$@" ;;
    restore)        cmd_restore "$@" ;;
    config)         cmd_config "$@" ;;
    *) echo "unknown subcommand: $SUBCOMMAND" >&2; usage ;;
esac
